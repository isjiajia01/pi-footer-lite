{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["./node_modules/@types"]
	},
	"include": ["index.ts", "src/**/*.ts", "tests/**/*.ts"]
}
